{
	# Cloudflare terminates public TLS, we provide certs manually
	auto_https off
}

carlostoolkit.com {
	tls {$TLS_CERT} {$TLS_KEY}
	reverse_proxy 127.0.0.1:3090
}

*.carlostoolkit.com {
	tls {$TLS_CERT} {$TLS_KEY}
	encode zstd gzip

	@me host me.carlostoolkit.com
	reverse_proxy @me 127.0.0.1:3090 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}

	@logs host logs.carlostoolkit.com
	reverse_proxy @logs 127.0.0.1:3100 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}

	@flashcards host flashcards.carlostoolkit.com
	reverse_proxy @flashcards 127.0.0.1:3210 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}

	@health host health.carlostoolkit.com
	reverse_proxy @health 127.0.0.1:3201 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 90s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}

	@media host media.carlostoolkit.com
	reverse_proxy @media 127.0.0.1:3300 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}

	@notes host notes.carlostoolkit.com
	reverse_proxy @notes 127.0.0.1:3010 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}

	@arido host arido.carlostoolkit.com
	reverse_proxy @arido 127.0.0.1:3400 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}


	@vextor host vextor.carlostoolkit.com
	reverse_proxy @vextor 127.0.0.1:3600 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			# Uploads of phone photos/PDFs pass through the app.
			response_header_timeout 120s
			keepalive 30s
			keepalive_idle_conns 10
		}
	}
}
