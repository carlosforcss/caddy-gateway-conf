# Host directory containing the Cloudflare origin certificate and private key.
TLS_CERTS_DIR=/etc/ssl/cloudflare

# Paths as seen inside the container. The files come from TLS_CERTS_DIR.
TLS_CERT=/certs/origin.pem
TLS_KEY=/certs/origin-key.pem

# Optional local image name.
CADDY_IMAGE=caddy-gateway:local
